206|193|        # ── 3. Main loop ────────────────────────────────────────
207|194|        last_tab_time = time.time()
208|195|        recovery_attempts = 0       # лічильник recover_back/open_instagram
209|196|        last_productive_action_at = time.time()  # час останнього product-у action
210|197|
211|198|        while not budget.is_done():
212|199|            now = time.time()
213|200|
214|201|            # 3.1 Detect state
215|202|            state = detect_screen(d)
216|203|
217|204|            # 3.0 DEAD LOOP DETECTION — якщо >60s без жодної продуктивної дії
218|205|            # (тільки recovery/wait) — виходимо з error
219|206|            if now - last_productive_action_at > 60:
220|207|                log(f"DEAD LOOP detected: {recovery_attempts} recovery attempts, "
221|208|                    f"no productive action for {now - last_productive_action_at:.0f}s")
222|209|                error = f"dead loop (recovery {recovery_attempts}x)"
223|210|                break
224|211|
225|212|            # 3.2 Track time in current tab
226|213|            cur_tab = _tab_name(state)
227|214|            if cur_tab:
228|215|                budget.time_in_tab[cur_tab] = budget.time_in_tab.get(cur_tab, 0) + (now - last_tab_time)
229|216|            last_tab_time = now
230|217|
231|218|            # 3.3 AI evaluation на новому reel
232|219|            if (use_ai and state.type == 'REELS_FEED'
233|220|                    and niche and niche.is_configured()
234|221|                    and memory.action_counter - last_ai_reel_at_action >= 1
235|222|                    and memory.last_ai_decision is None):
236|223|                # Новий reel — оцінюємо (text first, vision як fallback)
237|224|                try:
238|225|                    # Даємо UI час завантажити TextView після scroll
239|226|                    time.sleep(0.7)
240|227|                    reel_text = read_reel_text(d, min_len=0) or ""
241|228|                    decision = None
242|229|
243|230|                    if len(reel_text.strip()) >= 10:
244|231|                        # Text-only — швидко
245|232|                        decision = ai_decide_reel_text(reel_text, niche, timeout=15)
246|233|                        log(f"AI [text] → {decision['action']}: {decision.get('reason','')[:80]}")
247|234|                    elif vision_calls_used < max_vision_calls:
248|235|                        # Vision fallback — робимо screenshot через PIL
249|236|                        try:
250|237|                            png = _grab_screenshot_bytes(d)
251|238|                            if png and len(png) > 1000:
252|239|                                decision = ai_decide_reel_vision(png, niche, timeout=25)
253|240|                                vision_calls_used += 1
254|241|                                log(f"AI [vision #{vision_calls_used}] → {decision['action']}: {decision.get('reason','')[:80]}")
255|242|                            else:
256|243|                                log(f"AI vision skip: screenshot empty ({len(png) if png else 0}b)")
257|244|                        except Exception as ve:
258|245|                            log(f"AI vision error: {ve}")
259|246|
260|247|                    if decision:
261|248|                        # Downgrade якщо бюджет вичерпано — щоб у логах відображалось
262|249|                        # реальне поведінка, не "phantom" save decisions.
263|250|                        if decision['action'] == 'save' and budget.saves_given >= budget.max_saves:
264|251|                            if budget.likes_given < budget.max_likes:
265|252|                                decision['downgraded_from'] = 'save'
266|253|                                decision['downgrade_reason'] = f'save limit reached ({budget.max_saves})'
267|254|                                decision['action'] = 'like'
268|255|                            else:
269|256|                                decision['downgraded_from'] = 'save'
270|257|                                decision['downgrade_reason'] = f'save limit reached, likes also at limit'
271|258|                                decision['action'] = 'skip'
272|259|                            log(f"  [downgrade] save → {decision['action']}: {decision['downgrade_reason']}")
273|260|                        elif decision['action'] == 'like' and budget.likes_given >= budget.max_likes:
274|261|                            decision['downgraded_from'] = 'like'
275|262|                            decision['downgrade_reason'] = f'likes limit reached ({budget.max_likes})'
276|263|                            decision['action'] = 'skip'
277|264|                            log(f"  [downgrade] like → skip: {decision['downgrade_reason']}")
278|265|                        memory.last_ai_decision = decision['action']
279|266|                        ai_decisions.append(decision)
280|267|                    else:
281|268|                        memory.last_ai_decision = 'skip'
282|269|                        log(f"AI skip: no signal (text={len(reel_text)}, vision_used={vision_calls_used}/{max_vision_calls})")
283|270|
284|271|                    last_ai_reel_at_action = memory.action_counter
285|272|                except Exception as e:
286|273|                    log(f"AI error: {e} — skip")
287|274|                    memory.last_ai_decision = 'skip'
288|275|
289|276|            # 3.4 Policy → обираємо наступну дію
290|277|            action = next_action(state, budget, memory)
291|278|
292|279|            if action.kind == 'end_session':
293|280|                log(f"end_session: {action.reason}")
294|281|                break
295|282|
296|283|            # 3.5 Execute
297|284|            log(f"{state.type:<18} → {action.kind:<24} | {action.reason[:50]}")
298|285|            result = execute(d, action, state)
299|286|            actions_log.append(action.kind)
300|287|
301|288|            if not result.ok:
302|289|                log(f"  FAIL: {result.error[:80]}")
303|290|
304|291|            # 3.6 Update budget/memory з side_effects
305|292|            fx = result.side_effects or {}
306|293|            if fx.get('liked') is True:
307|294|                budget.likes_given += 1
308|295|                memory.last_like_at = time.time()
309|296|                current_reel_liked = True
310|297|            if fx.get('saved') is True:
311|298|                budget.saves_given += 1
312|299|                memory.last_save_at = time.time()
313|300|                current_reel_saved = True
314|301|            if 'reel' in action.kind and 'scroll' in action.kind:
315|302|                budget.reels_watched += 1
316|303|            if fx.get('peeked') is True:
317|304|                budget.profile_peeks += 1
318|305|            if action.kind.startswith('goto_') or action.kind == 'open_instagram':
319|306|                budget.tab_switches += 1
320|307|            if fx.get('watched') is True and state.type == 'STORY_VIEWER':
321|308|                budget.stories_watched += 1
322|309|
323|310|            # 3.7 Reset AI state коли переходимо на НАСТУПНИЙ reel
324|311|            if action.kind == 'reel_scroll_next':
325|312|                memory.last_ai_decision = None
326|313|                current_reel_liked = False
327|314|                current_reel_saved = False
328|315|
329|316|            # 3.75 Трекер recovery/productive actions (для dead loop detection)
330|317|            recovery_kinds = {'wait', 'wake_and_unlock', 'recover_back',
331|318|                               'close_modal', 'open_instagram', 'skip_ad'}
332|319|            if action.kind in recovery_kinds:
333|320|                recovery_attempts += 1
334|321|                # Якщо > 6 recovery спроб підряд — уже явно щось не так
335|322|                if recovery_attempts > 6:
336|323|                    log(f"EARLY EXIT: {recovery_attempts} recovery attempts in a row")
337|324|                    error = f"too many recovery attempts ({recovery_attempts})"
338|325|                    break
339|326|                # Добавляємо довшу паузу після кожного recovery щоб не дати циклу "пальнути"
340|327|                time.sleep(2.0)
341|328|            else:
342|329|                recovery_attempts = 0
343|330|                last_productive_action_at = time.time()
344|331|
345|332|            # 3.8 Записуємо в memory (впливає на consecutive_scrolls, тощо)
346|333|            memory.record(action.kind)
347|334|
348|335|            # 3.9 Оновлюємо memory прапорці
349|336|            memory.already_liked_this_reel = current_reel_liked
350|337|            memory.already_saved_this_reel = current_reel_saved
351|338|
352|339|        # ── 4. Cleanup ─────────────────────────────────────────
353|340|        log(f"cleanup: reels={budget.reels_watched}, likes={budget.likes_given}, "
