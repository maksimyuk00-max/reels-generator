36|36|
37|37|def run_warmup_session(
38|38|    serial: str | None = None,
39|39|    duration_seconds: int = 360,
40|40|    niche: NicheProfile | None = None,
41|41|    proxy: str | None = None,
42|42|    use_ai: bool = True,
43|43|    max_likes: int | None = None,      # якщо None — 5% від очікуваних reels
44|44|    max_saves: int | None = None,
45|45|    log_fn=None,                        # optional: callback для логів
46|46|    session_id: int | None = None,     # id у БД для прямого запису результату
47|47|    db_path: str | None = None,        # шлях до SQLite (з Electron)
48|48|    engine: str = 'v2',                 # для db.engine field
49|49|    expected_username: str | None = None,  # активний IG акаунт має бути = цим
50|50|) -> dict:
51|51|    """Запустити повну warmup сесію з mixed actions.
52|52|
53|53|    Args:
54|54|        serial:            ADB host (None = default)
55|55|        duration_seconds:  тривалість
56|56|        niche:             налаштована ніша (NicheProfile або None щоб не використовувати AI)
57|57|        proxy:             "host:port:user:pass" або None
58|58|        use_ai:            вмикає AI relevance (якщо niche заповнено)
59|59|        max_likes/saves:   жорсткі ліміти (None → розраховуємо: 5%/2% від reels)
60|60|        log_fn:            callable(str) для логів
61|61|
62|62|    Returns:
63|63|        {
64|64|            "ok": True,
65|65|            "reels_watched": int,
66|66|            "likes_given": int,
67|67|            "saves_given": int,
68|68|            "stories_watched": int,
69|69|            "ai_decisions": list[dict],
70|70|            "duration": float,
71|71|            "time_in_tab": {...},
72|72|            "tab_switches": int,
73|73|            "actions": list[str],   # послідовність дій для debug
74|74|            "error": str | None,
75|75|        }
76|76|    """
77|77|    import uiautomator2 as u2
78|78|    from android_poster import _set_proxy, _set_uk_disguise, read_reel_text
79|79|
80|80|    def log(msg: str) -> None:
81|81|        if log_fn:
82|82|            try: log_fn(msg)
83|83|            except Exception: pass
84|84|        print(f"[v2] {msg}", flush=True)
85|85|
86|86|    # ── 0. Connect ──────────────────────────────────────────────
87|87|    try:
88|88|        d = u2.connect(serial) if serial else u2.connect()
89|89|    except Exception as e:
90|90|        return {"ok": False, "error": f"Device connect failed: {e}"}
91|91|
92|92|    log(f"Session start: {duration_seconds}s, AI={use_ai}, "
93|93|        f"niche={'configured' if (niche and niche.is_configured()) else 'NONE'}")
94|94|
95|95|    # ── 1. Proxy & disguise ─────────────────────────────────────
96|96|    proxy_set = False
97|97|    orig_disguise = None
98|98|
99|99|    # Estimate очікуваних reels для лімітів (для 6 хв = ~50 reels)
100|100|    # Cred 20-25 reels/хв з природніми паузами
101|101|    expected_reels = max(1, int(duration_seconds / 12))
102|102|    if max_likes is None:
103|103|        max_likes = max(1, int(expected_reels * 0.05))   # 5%
104|104|    if max_saves is None:
105|105|        max_saves = max(1, int(expected_reels * 0.02))   # 2%
106|106|
107|107|    budget = SessionBudget(
108|108|        total_seconds=float(duration_seconds),
109|109|        max_likes=max_likes,
110|110|        max_saves=max_saves,
111|111|    )
112|112|    memory = SessionMemory()
113|113|
114|114|    # Трекер: коли востаннє викликали AI для reel (за action counter'ом)
115|115|    last_ai_reel_at_action = -999
116|116|    # Прапорці для поточного reel
117|117|    current_reel_liked = False
118|118|    current_reel_saved = False
119|119|    # Ліміт vision викликів (дорогий fallback) — max ~30% від reels
120|120|    max_vision_calls = max(3, int(duration_seconds / 60 * 3))  # ~3 на 60с
121|121|    vision_calls_used = 0
122|122|
123|123|    actions_log: list[str] = []
124|124|    ai_decisions: list[dict] = []
125|125|    error: str | None = None
126|126|    last_tab_time = time.time()
127|127|
128|128|    try:
129|129|        if proxy:
130|130|            parts = proxy.strip().split(":")
131|131|            if len(parts) >= 2:
132|132|                try:
133|133|                    _set_proxy(d, parts[0], int(parts[1]),
134|134|                               parts[2] if len(parts) > 2 else "",
135|135|                               parts[3] if len(parts) > 3 else "")
136|136|                    proxy_set = True
137|137|                    log("proxy set OK")
138|138|                except Exception as e:
139|139|                    return {"ok": False, "error": f"Proxy setup failed: {e}"}
140|140|
141|141|        try:
142|142|            orig_disguise = _set_uk_disguise(d)
143|143|        except Exception as e:
144|144|            log(f"disguise warn: {e}")
145|145|
146|146|        # ── 2. Open IG ──────────────────────────────────────────
147|147|        # Wake + unlock (повний цикл: KEYCODE_WAKEUP + перевірка Display Power +
148|148|        # swipe up для dismissing lockscreen + dismiss-keyguard).
149|149|        # Простий KEYCODE_WAKEUP не дає dismiss lockscreen → IG не стартує.
150|150|        try:
151|151|            from android_poster import _wake_and_unlock
152|152|            d.shell("svc power stayon true")
153|153|            _wake_and_unlock(d)
154|154|            # Підтверджуємо що екран увімкнувся; до 3 спроб
155|155|            for _ in range(3):
156|156|                power_state = d.shell("dumpsys power | grep 'Display Power'").output
157|157|                if "state=ON" in power_state:
158|158|                    break
159|159|                d.shell("input keyevent KEYCODE_WAKEUP")
160|160|                time.sleep(1.0)
161|161|                d.shell("wm dismiss-keyguard")
162|162|                time.sleep(0.5)
163|163|        except Exception as e:
164|164|            log(f"wake_and_unlock warn: {e}")
165|165|
166|166|        # Закриваємо і знову відкриваємо IG — чистий старт
167|167|        try:
168|168|            from android_poster import IG_PKG
169|169|            d.app_stop(IG_PKG)
170|170|            time.sleep(0.8)
171|171|            d.app_start(IG_PKG, use_monkey=True)
172|172|        except Exception as e:
173|173|            log(f"app_start warn: {e}")
174|174|
175|175|        time.sleep(6.0)  # splash + feed load (збільшено з 3.5с: на слабких телефонах
                        # профіль/feed не встигали прогрузитись, даючи фальшивий
                        # "could not read active IG account")
176|176|
177|177|        # ── 2.5. Ніжна перевірка активного акаунта (2026-09-20) ────────
178|178|        # Перед прогрівом переконуємось що активний IG акаунт = той, для якого
179|179|        # заплановано прогрів. Profile tab (1 тап, без світчера) → читаємо
180|180|        # username. Якщо не той — перемикаємось через світчер. Якщо потрібного
181|181|        # немає на пристрої — помилка, щоб не гріти чужий акаунт.
182|182|                        if expected_username:
            try:
                from android_poster import _ensure_ig_account
                log(f"STRICT CHECK: Target account is @{expected_username}")
                ok_acc, acc_msg = _ensure_ig_account(d, expected_username)
                log(f"STRICT CHECK RESULT: {acc_msg}")
                if not ok_acc:
                    log(f"CRITICAL ERROR: Account mismatch! Expected @{expected_username}, but {acc_msg}. Aborting to prevent wrong account warmup.")
                    return {"ok": False, "error": f"Account mismatch: {acc_msg}"}
            except Exception as e:
                log(f"STRICT CHECK EXCEPTION: {e}")
                return {"ok": False, "error": f"Account check failed: {e}"}

            # GUARANTEE: Return to Home Feed after account check/switch.
            try:
                from android_poster import IG_PKG
                home_tab = d(resourceId=f"{IG_PKG}:id/feed_tab")
                if home_tab.exists:
                    home_tab.click()
                    time.sleep(2.0)
                    log("Returned to home feed for session start")
            except Exception as e:
                log(f"Return home warn: {e}")

192|
193|            # КРИТИЧНО: Після перевірки/перемикання акаунта ми можемо бути на екрані Профілю.
194|            # Оркестратор очікує старт з HOME_FEED. Повертаємось на головну.
195|            try:
196|                from android_poster import IG_PKG
197|                home_tab = d(resourceId=f"{IG_PKG}:id/feed_tab")
198|                if home_tab.exists:
199|                    home_tab.click()
200|                    time.sleep(1.5)
201|                    log("returned to home feed after account check")
202|            except Exception as e:
203|                log(f"return home warn: {e}")
204|
