423|410|                'ai_cache_read_tokens': total_cache_read,
424|411|                'ai_cost_usd': round(total_cost, 6),
425|412|                'ai_calls': len(ai_decisions),
426|413|                'engine': engine,
427|414|            }
428|415|            db_r = update_warmup_session(db_path, session_id, db_data)
429|416|            if db_r.get('ok'):
430|417|                log(f"DB write OK: session #{session_id} → {db_data['status']}")
431|418|                result['db_written'] = True
432|419|            else:
433|420|                log(f"DB write FAIL: {db_r.get('error')}")
434|421|                result['db_written'] = False
435|422|                result['db_error'] = db_r.get('error')
436|423|        except Exception as e:
437|424|            log(f"DB write exception: {e}")
438|425|            result['db_written'] = False
439|426|            result['db_error'] = str(e)
440|427|
441|428|    return result
442|429|
443|430|
444|431|def _grab_screenshot_bytes(d) -> bytes | None:
445|432|    """Взяти скріншот пристрою як PNG bytes.
446|433|
447|434|    uiautomator2 за замовчуванням повертає PIL Image. Конвертуємо у bytes.
448|435|    Різні версії u2 мають різні сигнатури — намагаємось кілька варіантів.
449|436|    """
450|437|    import io
451|438|
452|439|    # Спроба 1: default (повертає PIL Image)
453|440|    try:
454|441|        img = d.screenshot()
455|442|        if img is None:
456|443|            return None
457|444|        # PIL Image → PNG bytes
458|445|        if hasattr(img, 'save'):
459|446|            buf = io.BytesIO()
460|447|            img.save(buf, format='PNG')
461|448|            return buf.getvalue()
462|449|        # Уже bytes?
463|450|        if isinstance(img, (bytes, bytearray)):
464|451|            return bytes(img)
465|452|    except Exception:
466|453|        pass
467|454|
468|455|    # Спроба 2: через adb shell screencap
469|456|    try:
470|457|        import tempfile, os
471|458|        tmp = tempfile.NamedTemporaryFile(suffix='.png', delete=False)
472|459|        tmp.close()
473|460|        try:
474|461|            d.screenshot(tmp.name)
475|462|            with open(tmp.name, 'rb') as f:
476|463|                return f.read()
477|464|        finally:
478|465|            try: os.unlink(tmp.name)
479|466|            except Exception: pass
480|467|    except Exception:
481|468|        return None
482|469|
483|470|
484|471|def _tab_name(state: ScreenState) -> str | None:
485|472|    m = {
486|473|        'HOME_FEED': 'home', 'REELS_FEED': 'reels',
487|474|        'STORY_VIEWER': 'stories', 'EXPLORE': 'explore',
488|475|        'PROFILE_OWN': 'profile', 'PROFILE_OTHER': 'profile',
489|476|    }
490|477|    return m.get(state.type)
491|478|
492|
