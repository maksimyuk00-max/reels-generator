1334|
1335|def _read_active_username_profile(d) -> str | None:
    """Side-trip на Profile tab щоб прочитати username.
    Додано очікування (retry), щоб не вилітати занадто швидко.
    """
    import re
    
    # 1. Чекаємо на Profile tab (до 10 секунд)
    tab = None
    for _ in range(5):
        try:
            el = d(resourceId=f"{IG_PKG}:id/profile_tab")
            if el.exists:
                tab = el
                break
        except Exception:
            pass
        time.sleep(2)
    
    if not tab:
        return None
        
    try:
        tab.click()
    except Exception:
        return None

    # 2. Чекаємо на завантаження профілю (action_bar_title)
    username = None
    deadline = time.time() + 10
    while time.time() < deadline:
        time.sleep(1.0)
        try:
            # Перевіряємо всі можливі селектори
            title_selectors = [
                f"{IG_PKG}:id/action_bar_title",
                f"{IG_PKG}:id/action_bar_large_title",
                f"{IG_PKG}:id/action_bar_large_title_auto_size",
                f"{IG_PKG}:id/title",
            ]
            for rid in title_selectors:
                el = d(resourceId=rid)
                if el.exists:
                    t_text = (el.get_text() or "").strip().lstrip("@").lower()
                    if re.match(r'^[a-z0-9._]{1,30}$', t_text):
                        username = t_text
                        break
            if username: break
        except Exception:
            continue

    # 3. Повертаємось на Home
    try:
        home_tab = d(resourceId=f"{IG_PKG}:id/feed_tab")
        if home_tab.exists:
            home_tab.click()
            time.sleep(1.0)
    except Exception:
        pass

    return username

1407|
1408|
1409|def _open_account_switcher(d) -> bool:
1410|    """Відкриває account switcher bottom-sheet (на Profile) і перевіряє що
1411|    він реально відкрився. Повертає bool.
1412|
1413|    КРИТИЧНО (2026-09-21): перед відкриттям світчера ми МОЖЕМО бути НЕ на
1414|    Profile — _read_active_username_profile у кінці повертає на Home
1415|    (feed_tab). На Home немає action_bar_title, тому світчер не відкриється.
1416|    Отже СПЕРШУ гарантуємо, що ми на Profile (тап profile_tab + чекаємо
1417|    profile_header_container), і лише тоді шукаємо action_bar_title.
1418|    """
1419|    sheet_markers = ["Add Instagram account", "Go to Accounts Center",
1420|                     "Add account", "Log in to existing account",
1421|                     "Створити новий", "Увійти до існуючого",
1422|                     "Switch accounts", "Switch Account"]
1423|
1424|    def _sheet_is_open():
1425|        try:
1426|            hier = d.dump_hierarchy()
1427|            return any(m in hier for m in sheet_markers)
1428|        except Exception:
1429|            return False
1430|
1431|    # ── Крок 0: гарантуємо що ми на Profile ─────────────────────
1432|    on_profile = False
1433|    try:
1434|        tab = d(resourceId=f"{IG_PKG}:id/profile_tab")
1435|        if not tab.exists:
1436|            return False
1437|        tab.click()
1438|        deadline = time.time() + 8
1439|        while time.time() < deadline:
1440|            time.sleep(0.6)
1441|            try:
1442|                if d(resourceId=f"{IG_PKG}:id/profile_header_container").exists:
1443|                    on_profile = True
1444|                    break
1445|            except Exception:
1446|                continue
1447|    except Exception:
1448|        pass
1449|    if not on_profile:
1450|        return False
1451|
1452|    # ── Спроба 1: тап на title ──────────────────────────────────
1453|    try:
1454|        title = d(resourceId=f"{IG_PKG}:id/action_bar_title")
1455|        if title.exists:
1456|            title.click()
1457|            time.sleep(1.8)
1458|            if _sheet_is_open():
1459|                return True
1460|    except Exception:
1461|        pass
1462|
1463|    # ── Спроба 2: тап на chevron праворуч від title ─────────────
1464|    try:
1465|        title = d(resourceId=f"{IG_PKG}:id/action_bar_title")
1466|        if title.exists:
1467|            b = title.info.get('bounds', {})
1468|            if b:
1469|                d.click(b['right'] + 40, (b['top'] + b['bottom']) // 2)
1470|                time.sleep(1.8)
1471|                if _sheet_is_open():
1472|                    return True
1473|    except Exception:
1474|        pass
1475|
1476|    # ── Спроба 3: тап на title ще раз (після короткої паузи) ──
1477|    time.sleep(0.8)
1478|    try:
1479|        title = d(resourceId=f"{IG_PKG}:id/action_bar_title")
1480|        if title.exists:
1481|            title.click()
1482|            time.sleep(1.8)
1483|            if _sheet_is_open():
1484|                return True
1485|    except Exception:
1486|        pass
1487|
1488|    return False
