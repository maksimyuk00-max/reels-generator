1613|def get_active_ig_account(serial: str | None = None) -> dict:
1614|    """
1615|    Визначає активний IG акаунт. Просто:
1616|      1. Відкрити IG
1617|      2. Тап на Profile tab у НИЖНЬОМУ ПРАВОМУ куті (по координатах — найнадійніше)
1618|      3. Прочитати username з action_bar_large_title
1619|    """
1620|    import time
1621|    try:
1622|        d = _connect(serial)
1623|    except Exception as e:
1624|        return {"ok": False, "error": f"connect fail: {e}"}
1625|
1626|    try:
1627|        # Wake + unlock якщо треба
1628|        _wake_and_unlock(d)
1629|
1630|        if not d.app_info(IG_PKG).get("versionName"):
1631|            return {"ok": False, "error": "Instagram не встановлено на пристрої"}
1632|
1633|        d.app_start(IG_PKG, use_monkey=True)
1634|        time.sleep(3)
1635|
1636|        # Розміри екрану
1637|        info = d.info
1638|        w = info.get("displayWidth", 1080)
1639|        h = info.get("displayHeight", 1920)
1640|
1641|        # Тап на Profile tab — нижній ПРАВИЙ кут
1642|        # IG bottom nav: 5 іконок рівномірно, остання — Profile
1643|        # Координати: ~90% ширини, ~97% висоти
1644|        profile_x = int(w * 0.9)
1645|        profile_y = int(h * 0.97)
1646|
1647|        # Спроба 1: resource-id (якщо є — найкраще)
1648|        tab = d(resourceId=f"{IG_PKG}:id/profile_tab")
1649|        clicked = False
1650|        if hasattr(tab, 'exists') and tab.exists:
1651|            try:
1652|                tab.click()
1653|                clicked = True
1654|            except Exception:
1655|                pass
1656|
1657|        # Спроба 2: по координатах (нижній правий)
1658|        if not clicked:
1659|            d.click(profile_x, profile_y)
1660|            clicked = True
1661|
1662|        time.sleep(2.5)
1663|
1664|        # Читаємо username з хедера Profile
1665|        title_selectors = [
1666|            f"{IG_PKG}:id/action_bar_large_title_auto_size",
1667|            f"{IG_PKG}:id/action_bar_large_title",
1668|            f"{IG_PKG}:id/action_bar_title",
1669|            f"{IG_PKG}:id/title",
1670|        ]
1671|        for rid in title_selectors:
1672|            el = d(resourceId=rid)
1673|            if hasattr(el, 'exists') and el.exists:
1674|                try:
1675|                    text = el.get_text()
1676|                    if text:
1677|                        username = text.strip().lstrip('@').lower()
1678|                        # Валідація username IG: a-z, 0-9, ., _
1679|                        import re
1680|                        if re.match(r'^[a-z0-9._]{1,30}$', username):
1681|                            return {"ok": True, "username": username}
1682|                except Exception:
1683|                    continue
1684|
1685|        return {"ok": False,
1686|                "error": "Username не знайдено. Переконайся що ти у Profile tab на IG."}
1687|
1688|    except Exception as e:
1689|        return {"ok": False, "error": f"{type(e).__name__}: {e}"}
1690|
1691|
1692|def _list_usb_devices() -> list[str]:
1693|    """Повертає список USB серійників (не IP-адреси) з `adb devices`."""
1694|    r = _run_adb("devices", timeout=5)
1695|    if not r["ok"]:
1696|        return []
1697|    usb = []
1698|    for line in r["output"].splitlines():
1699|        line = line.strip()
1700|        if not line or line.startswith("List of") or "offline" in line or "unauthorized" in line:
1701|            continue
1702|        parts = line.split()
1703|        if len(parts) >= 2 and parts[1] == "device":
1704|            serial = parts[0]
1705|            # USB serial: БЕЗ крапки в імені (не IP:port)
1706|            if "." not in serial:
1707|                usb.append(serial)
1708|    return usb
1709|
1710|
1711|def _get_device_wifi_ip(serial: str | None = None) -> str | None:
1712|    """Витягує Wi-Fi IP з телефону через `adb shell ip`."""
1713|    args = []
1714|    if serial:
1715|        args += ["-s", serial]
1716|    args += ["shell", "ip", "-f", "inet", "addr", "show", "wlan0"]
1717|    r = _run_adb(*args, timeout=5)
1718|    if not r["ok"]:
1719|        return None
1720|    import re
1721|    m = re.search(r"inet (\d+\.\d+\.\d+\.\d+)/", r["output"])
1722|    return m.group(1) if m else None
1723|
1724|
1725|def _get_device_wifi_mac(serial: str | None = None) -> str | None:
1726|    """Витягує WiFi MAC адресу пристрою. Використовується для rediscover при зміні DHCP IP.
1727|
1728|    Спершу пробує `cat /sys/class/net/wlan0/address` (надійно на всіх Android).
1729|    Fallback: parse з `ip link show wlan0`. Повертає lowercase з двокрапками: 'aa:bb:cc:dd:ee:ff'.
1730|    """
1731|    args_base = []
1732|    if serial:
1733|        args_base += ["-s", serial]
1734|    # Strategy 1: read /sys file
1735|    r = _run_adb(*args_base, "shell", "cat", "/sys/class/net/wlan0/address", timeout=5)
1736|    if r["ok"]:
1737|        mac = (r["output"] or "").strip().lower()
1738|        if len(mac) == 17 and mac.count(":") == 5:
1739|            return mac
1740|    # Strategy 2: parse ip link
1741|    r = _run_adb(*args_base, "shell", "ip", "link", "show", "wlan0", timeout=5)
1742|    if r["ok"]:
1743|        import re
1744|        m = re.search(r"link/ether ([0-9a-f:]{17})", r["output"] or "", re.IGNORECASE)
1745|        if m:
1746|            return m.group(1).lower()
1747|    return None
1748|
1749|
1750|def scan_usb_devices() -> dict:
1751|    """
1752|    Сканує підключені по USB Android пристрої і повертає інфо про кожний:
1753|    {serial, model, wifi_ip, android_version}
1754|    """
1755|    usb_serials = _list_usb_devices()
1756|    devices = []
1757|    for serial in usb_serials:
1758|        info = {"serial": serial}
1759|        try:
1760|            r = _run_adb("-s", serial, "shell", "getprop", "ro.product.model", timeout=3)
1761|            info["model"] = r["output"].strip() if r["ok"] else None
1762|        except Exception:
1763|            info["model"] = None
1764|        try:
1765|            r = _run_adb("-s", serial, "shell", "getprop", "ro.build.version.release", timeout=3)
1766|            info["android_version"] = r["output"].strip() if r["ok"] else None
1767|        except Exception:
1768|            info["android_version"] = None
1769|        info["wifi_ip"] = _get_device_wifi_ip(serial)
1770|        info["wifi_mac"] = _get_device_wifi_mac(serial)
1771|        devices.append(info)
1772|    return {"ok": True, "devices": devices}
1773|
1774|
1775|def register_usb_device(serial: str) -> dict:
1776|    """
1777|    Підключає USB-пристрій як Wi-Fi ADB. Робить:
1778|      1. adb tcpip 5555 на USB пристрої
1779|      2. Отримує Wi-Fi IP пристрою
1780|      3. adb connect <ip>:5555
1781|    Повертає WiFi host, model, android_version.
1782|    """
1783|    import time
1784|    wifi_ip = _get_device_wifi_ip(serial)
1785|    if not wifi_ip:
1786|        return {"ok": False, "error": f"Пристрій {serial} не підключений до Wi-Fi"}
1787|
1788|    # Tcpip 5555
1789|    r = adb_tcpip(serial, 5555)
1790|    if not r.get("ok"):
1791|        return {"ok": False, "error": f"adb tcpip 5555 fail: {r.get('error')}"}
1792|    time.sleep(2)
1793|
1794|    # Connect через WiFi
1795|    wifi_host = f"{wifi_ip}:5555"
1796|    conn = adb_connect(wifi_host)
1797|    if not conn.get("ok"):
1798|        return {"ok": False, "error": f"WiFi connect fail: {conn.get('error')}"}
1799|
1800|    # Беремо модель
1801|    model = None
1802|    try:
1803|        mr = _run_adb("-s", wifi_host, "shell", "getprop", "ro.product.model", timeout=3)
1804|        if mr["ok"]: model = mr["output"].strip()
1805|    except Exception:
1806|        pass
1807|
1808|    # Беремо MAC для майбутнього auto-rediscover при DHCP-зміні IP
1809|    wifi_mac = _get_device_wifi_mac(serial)
1810|
1811|    return {"ok": True, "wifi_host": wifi_host, "model": model or serial,
1812|            "wifi_mac": wifi_mac,
1813|            "message": f"Зареєстровано: {model} ({wifi_host})"}
1814|
1815|
1816|def rediscover_by_mac(wifi_mac: str, port: int = 5555, timeout_per_ip: float = 0.4) -> dict:
1817|    """Знайти пристрій у локальній мережі за збереженою WiFi MAC адресою.
1818|
1819|    Корисно коли DHCP видав новий IP — стара saved_host не працює.
1820|    Алгоритм:
1821|      1. Визначити локальну /24 підмережу з IP цього PC
1822|      2. Ping sweep усіх IP щоб заповнити ARP таблицю
1823|      3. Прочитати arp -a, знайти збережений MAC → новий IP
1824|      4. Спробувати adb connect <new_ip>:5555
1825|      5. Повернути новий host
1826|
1827|    Args:
1828|        wifi_mac: MAC адреса (формат 'aa:bb:cc:dd:ee:ff' lowercase)
1829|        port: ADB порт (default 5555)
1830|        timeout_per_ip: таймаут для ping одного IP
1831|
1832|    Returns:
1833|        {ok: True, wifi_host: 'ip:port'} або {ok: False, error: str}
1834|    """
1835|    import socket, subprocess, re
1836|
1837|    if not wifi_mac:
1838|        return {"ok": False, "error": "wifi_mac не вказано"}
1839|
1840|    target_mac = wifi_mac.lower().replace("-", ":")
1841|    if not re.match(r"^[0-9a-f:]{17}$", target_mac):
1842|        return {"ok": False, "error": f"Невалідний MAC: {wifi_mac}"}
1843|
1844|    # 1. Визначаємо локальну /24
1845|    try:
1846|        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
1847|        s.connect(("8.8.8.8", 80))
1848|        local_ip = s.getsockname()[0]
1849|        s.close()
1850|    except Exception as e:
1851|        return {"ok": False, "error": f"Не вдалось визначити локальну IP: {e}"}
1852|
1853|    parts = local_ip.split(".")
1854|    if len(parts) != 4:
1855|        return {"ok": False, "error": f"Дивна локальна IP: {local_ip}"}
1856|    subnet_prefix = ".".join(parts[:3])
1857|
1858|    # 2. Ping sweep (паралельно для швидкості)
1859|    import concurrent.futures as cf
1860|    def _ping(ip):
1861|        try:
1862|            subprocess.run(
1863|                ["ping", "-n", "1", "-w", str(int(timeout_per_ip * 1000)), ip],
1864|                capture_output=True, timeout=timeout_per_ip + 1,
1865|            )
1866|        except Exception:
1867|            pass
1868|
1869|    ips = [f"{subnet_prefix}.{i}" for i in range(2, 255) if f"{subnet_prefix}.{i}" != local_ip]
1870|    with cf.ThreadPoolExecutor(max_workers=32) as pool:
1871|        list(pool.map(_ping, ips))
1872|
1873|    # 3. ARP table → шукаємо MAC
1874|    try:
1875|        r = subprocess.run(["arp", "-a"], capture_output=True, text=True, timeout=10,
1876|                           encoding="utf-8", errors="replace")
1877|    except Exception as e:
1878|        return {"ok": False, "error": f"arp -a fail: {e}"}
1879|
1880|    found_ip = None
1881|    # Windows формат: "  192.168.0.5           9c-bc-f0-3d-12-d7     dynamic"
1882|    for line in r.stdout.splitlines():
1883|        m = re.match(r"\s*(\d+\.\d+\.\d+\.\d+)\s+([0-9a-fA-F-]{17})\s+", line)
1884|        if not m:
1885|            continue
1886|        ip = m.group(1)
1887|        mac = m.group(2).lower().replace("-", ":")
1888|        if mac == target_mac:
1889|            found_ip = ip
1890|            break
1891|
1892|    if not found_ip:
1893|        return {"ok": False, "error": f"MAC {target_mac} не знайдено в ARP таблиці після sweep"}
1894|
1895|    # 4. ADB connect
1896|    new_host = f"{found_ip}:{port}"
1897|    conn = adb_connect(new_host)
1898|    if not conn.get("ok"):
1899|        return {"ok": False, "error": f"Знайдено {new_host} але adb connect fail: {conn.get('error')}"}
1900|
1901|    return {"ok": True, "wifi_host": new_host, "wifi_ip": found_ip,
1902|            "message": f"Знайдено за MAC: {new_host}"}
1903|
1904|
1905|def ensure_wifi_connection(saved_host: str | None, allow_usb_recovery: bool = True) -> dict:
1906|    """
1907|    Гарантує активне Wi-Fi ADB з'єднання. Стратегія:
1908|      1. Пробує saved_host (з retry для transient fail).
1909|      2. На фейл — mDNS discovery (Android 11+, на старих ігнорується).
1910|      3. На фейл — якщо підключено USB, автоматично робить `tcpip 5555` і reconnect.
1911|      4. Повертає {ok, host, method, message} або {ok: False, error, need_usb}.
1912|    """
1913|    import time
1914|
1915|    # Step 1: try saved host з коротким retry + реальний ping
1916|    if saved_host:
1917|        for attempt in range(2):
1918|            r = adb_connect(saved_host)
1919|            if r.get("ok"):
1920|                ping = adb_ping_device(saved_host, timeout=4)
1921|                if ping.get("ok"):
1922|                    return {"ok": True, "host": saved_host, "method": "saved",
1923|                            "message": f"reused {saved_host}"}
1924|                # adb connect сказав OK, але пристрій не відповідає на shell —
1925|                # стара запис у кеші. Disconnect і повторимо або підемо на mDNS
1926|                adb_disconnect(saved_host)
1927|            if attempt == 0:
1928|                time.sleep(1.5)
1929|
1930|    # Step 2: mDNS (Android 11+)
1931|    disc = adb_mdns_discover()
1932|    if disc.get("ok") and disc.get("devices"):
1933|        for dev in disc["devices"]:
1934|            r = adb_connect(dev["host"])
1935|            if r.get("ok"):
1936|                return {"ok": True, "host": dev["host"], "method": "mdns",
1937|                        "message": f"discovered {dev['host']}"}
1938|
1939|    # Step 3: USB auto-recovery (Android 10 fallback)
1940|    if allow_usb_recovery:
1941|        usb_serials = _list_usb_devices()
1942|        if usb_serials:
1943|            usb_serial = usb_serials[0]
1944|            # Дістаємо IP телефону через USB
1945|            wifi_ip = _get_device_wifi_ip(usb_serial)
1946|            if not wifi_ip:
1947|                return {"ok": False, "need_usb": False,
1948|                        "error": f"USB пристрій {usb_serial} знайдено, але Wi-Fi IP не отримано. "
1949|                                 "Переконайся що телефон підключений до Wi-Fi."}
1950|            # Переключаємо у tcpip 5555
1951|            tcp_r = adb_tcpip(usb_serial, 5555)
1952|            if not tcp_r.get("ok"):
1953|                return {"ok": False, "need_usb": False,
1954|                        "error": f"adb tcpip 5555 fail: {tcp_r.get('error')}"}
1955|            time.sleep(2)  # adb daemon перезапускається
1956|            new_host = f"{wifi_ip}:5555"
1957|            conn_r = adb_connect(new_host)
1958|            if conn_r.get("ok"):
1959|                return {"ok": True, "host": new_host, "method": "usb-recovery",
1960|                        "message": f"USB auto-recovery → {new_host}"}
1961|            return {"ok": False, "need_usb": False,
1962|                    "error": f"tcpip 5555 встановлено, але connect fail: {conn_r.get('error')}"}
1963|
1964|    # Всі шляхи вичерпано
1965|    return {"ok": False, "need_usb": True,
1966|            "error": "Wi-Fi ADB недоступний. Підключи телефон по USB на 5 сек — система відновить автоматично."}
1967|
