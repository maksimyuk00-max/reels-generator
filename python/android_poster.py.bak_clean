1491|def _switch_ig_account(d, target_username: str) -> tuple[bool, str]:
1492|    """Переключає активний IG акаунт на target через світчер.
1493|
1494|    Використовується ТІЛЬКИ коли активний акаунт НЕ співпадає з target
1495|    (тобто ніжний шлях _read_active_username_profile вже визначив, що
1496|    треба перемикатись). Повертає (ok, info_message).
1497|
1498|    КЛЮЧОВА пастка (2026-09-21, виявлено живим тестом на Redmi):
1499|    текст ``kirtas867`` у світчері — це `clickable="false"` вузол, клік по
1500|    text НЕ лендиться. Клікабельний рядок акаунта має `content-desc="..."`,
1501|    `clickable="true"`. Отже шукаємо по `description` (content-desc), а text
1502|    тільки як fallback. Description — такий самий accessibility-атрибут,
1503|    НЕ координати, однаковий на всіх телефонах.
1504|    """
1505|    import re
1506|    target = target_username.strip().lstrip('@').lower()
1507|
1508|    opened = _open_account_switcher(d)
1509|    if not opened:
1510|        return False, "switcher not opened"
1511|
1512|    # Шукаємо клікабельний рядок з target у bottom-sheet.
1513|    # Спершу по description (content-desc рядка = username) — надійно,
1514|    # бо цей вузол clickable=true. Тільки fallback на text.
1515|    found_row = None
1516|    for variant in (target, f"@{target}"):
1517|        try:
1518|            el = d(description=variant)
1519|            if el.exists:
1520|                found_row = el
1521|                break
1522|        except Exception:
1523|            continue
1524|    if not found_row:
1525|        try:
1526|            el = d(descriptionContains=target)
1527|            if el.exists:
1528|                found_row = el
1529|        except Exception:
1530|            pass
1531|    # Fallback на text (старі версії IG показували username в text-вузлі)
1532|    if not found_row:
1533|        for variant in (target, f"@{target}"):
1534|            try:
1535|                el = d(text=variant)
1536|                if el.exists:
1537|                    found_row = el
1538|                    break
1539|            except Exception:
1540|                continue
1541|    if not found_row:
1542|        try:
1543|            el = d(textContains=target)
1544|            if el.exists:
1545|                found_row = el
1546|        except Exception:
1547|            pass
1548|
1549|    if not found_row:
1550|        try:
1551|            d.press("back")
1552|            time.sleep(0.5)
1553|        except Exception:
1554|            pass
1555|        return False, f"account @{target} not found in switcher (not logged in?)"
1556|
1557|    try:
1558|        # Клікаємо центр bounds — навіть якщо вузол text неклікабельний,
1559|        # його центр лежить у клікабельному рядку нижче.
1560|        if found_row.exists:
1561|            b = found_row.info.get('bounds', {})
1562|            if b.get('left') is not None:
1563|                cx = (b['left'] + b['right']) // 2
1564|                cy = (b['top'] + b['bottom']) // 2
1565|                d.click(cx, cy)
1566|            else:
1567|                found_row.click()
1568|        else:
1569|            found_row.click()
1570|    except Exception as e:
1571|        return False, f"row click: {e}"
1572|
1573|    time.sleep(3.0)
1574|
1575|    # Verify — активний тепер = target?
1576|    new_active = _read_active_username_profile(d)
1577|    if new_active == target:
1578|        return True, f"switched to @{target}"
1579|    return False, f"switch happened but active is @{new_active} (expected @{target})"
