1|"""
2|Android Instagram Reel posting via uiautomator2.
3|
4|Workflow:
5|1. Push video to device /sdcard/DCIM/ReelsGen/
6|2. Trigger media scan so Instagram gallery sees it
7|3. Open Instagram → tap "+" → tap "REEL"
8|4. Select most recent video from gallery
9|5. Next → Next → paste caption → Share
10|6. Wait for upload confirmation
11|
12|All taps use resourceId/text lookups (not fixed coordinates) so the script
13|works across devices. Human-like random delays inserted between actions.
14|"""
15|from __future__ import annotations
16|
17|import os
18|import time
19|import random
20|import shutil
21|from pathlib import Path
22|
23|IG_PKG = "com.instagram.android"
24|REMOTE_DIR = "/sdcard/DCIM/ReelsGen"
25|
26|# UK/Europe disguise defaults
27|UK_TIMEZONE = "Europe/London"
28|UK_LOCALE   = "en-GB"
29|
30|
31|def _set_proxy(d, host: str, port: int, user: str = "", password: str = "") -> None:
32|    """Set system-wide HTTP/HTTPS proxy on the device."""
33|    d.shell(f"settings put global http_proxy {host}:{port}")
34|    # For HTTPS proxy via global_proxy (Android 10+)
35|    d.shell(f"settings put global global_http_proxy_host {host}")
36|    d.shell(f"settings put global global_http_proxy_port {port}")
37|    if user:
38|        d.shell(f"settings put global global_http_proxy_username {user}")
39|        d.shell(f"settings put global global_http_proxy_password {password}")
40|
41|
42|def _clear_proxy(d) -> None:
43|    """Remove system proxy settings."""
44|    d.shell("settings put global http_proxy :0")
45|    d.shell("settings delete global global_http_proxy_host")
46|    d.shell("settings delete global global_http_proxy_port")
47|    d.shell("settings delete global global_http_proxy_username")
48|    d.shell("settings delete global global_http_proxy_password")
49|
50|
51|def _set_uk_disguise(d) -> dict:
52|    """Set timezone and locale to UK. Returns original values for restore."""
53|    orig_tz = d.shell("getprop persist.sys.timezone").output.strip()
54|    orig_locale = d.shell("getprop persist.sys.locale").output.strip() or \
55|                  d.shell("getprop ro.product.locale").output.strip()
56|
57|    # Set timezone
58|    d.shell(f"service call alarm 3 s16 {UK_TIMEZONE}")
59|    d.shell(f"setprop persist.sys.timezone {UK_TIMEZONE}")
60|
61|    # Set locale (requires root or shell on some devices; works on MIUI)
62|    d.shell(f"setprop persist.sys.locale {UK_LOCALE}")
63|    d.shell(f"setprop persist.sys.language en")
64|    d.shell(f"setprop persist.sys.country GB")
65|
66|    return {"timezone": orig_tz, "locale": orig_locale}
67|
68|
69|def _restore_disguise(d, orig: dict) -> None:
70|    """Restore original timezone and locale."""
71|    if orig.get("timezone"):
72|        d.shell(f"service call alarm 3 s16 {orig['timezone']}")
73|        d.shell(f"setprop persist.sys.timezone {orig['timezone']}")
74|    if orig.get("locale"):
75|        d.shell(f"setprop persist.sys.locale {orig['locale']}")
76|
77|
78|def _pause(lo: float = 1.2, hi: float = 2.8) -> None:
79|    time.sleep(random.uniform(lo, hi))
80|
81|
82|def _connect(serial: str | None = None):
83|    """Connect to an Android device. Returns uiautomator2 Device."""
84|    import uiautomator2 as u2
85|    if serial:
86|        return u2.connect(serial)
87|    return u2.connect()  # defaults to ADB_SERIAL env or single connected device
88|
89|
90|def device_status(serial: str | None = None) -> dict:
91|    """Check if device is reachable and Instagram is installed."""
92|    try:
93|        d = _connect(serial)
94|        info = d.info
95|        ig_installed = IG_PKG in d.app_list()
96|        ig_running = False
97|        try:
98|            ig_running = d.app_info(IG_PKG).get("versionName") is not None
99|        except Exception:
100|            pass
101|        return {
102|            "ok": True,
103|            "device": {
104|                "model": info.get("productName") or info.get("displayName"),
105|                "brand": info.get("brand"),
106|                "sdk": info.get("sdkInt"),
107|                "screen": f"{info.get('displayWidth')}x{info.get('displayHeight')}",
108|                "battery": d.shell("dumpsys battery | grep level").output.strip() if hasattr(d.shell("echo"), 'output') else None,
109|            },
110|            "instagram_installed": ig_installed,
111|            "instagram_running": ig_running,
112|        }
113|    except Exception as e:
114|        return {"ok": False, "error": f"{type(e).__name__}: {e}"}
115|
116|
117|def _push_and_scan(d, local_path: str) -> str:
118|    """Push video to device and trigger media scanner. Returns remote path."""
119|    filename = Path(local_path).name
120|    remote_path = f"{REMOTE_DIR}/{filename}"
121|    d.shell(f"mkdir -p {REMOTE_DIR}")
122|    d.push(local_path, remote_path)
123|    # Force media scanner to pick up the new file
124|    d.shell(
125|        f'am broadcast -a android.intent.action.MEDIA_SCANNER_SCAN_FILE '
126|        f'-d file://{remote_path}'
127|    )
128|    time.sleep(2)
129|    return remote_path
130|
131|
132|def _wait_tap(d, timeout: float = 15, **selector) -> bool:
133|    """Wait for an element matching selector, then tap it. Returns True on success."""
134|    el = d(**selector)
135|    if el.wait(timeout=timeout):
136|        el.click()
137|        return True
138|    return False
139|
140|
141|def post_reel(
142|    video_path: str,
143|    caption: str = "",
144|    serial: str | None = None,
145|    dry_run: bool = False,
146|    proxy: str | None = None,
147|) -> dict:
148|    """
149|    Upload a Reel through the Instagram Android app.
150|
151|    Args:
152|        video_path: absolute path to a local .mp4 file
153|        caption: caption text (may include hashtags)
154|        serial: optional ADB serial, for multi-device setups
155|        dry_run: if True, only push the file and open IG, skip posting
156|        proxy: "host:port" or "host:port:user:pass" — EU/UK proxy for geo-masking
157|
158|    Returns:
159|        {"ok": bool, "error"?: str, "step"?: str}
160|    """
161|    if not os.path.isfile(video_path):
162|        return {"ok": False, "error": f"File not found: {video_path}"}
163|
164|    try:
165|        d = _connect(serial)
166|    except Exception as e:
167|        return {"ok": False, "error": f"Device connect failed: {e}", "step": "connect"}
168|
169|    orig_disguise = None
170|    proxy_set = False
171|
172|    try:
173|        # 0. Geo-masking: proxy + UK timezone/locale
174|        if proxy:
175|            parts = proxy.strip().split(":")
176|            if len(parts) >= 2:
177|                try:
178|                    p_host, p_port = parts[0], int(parts[1])
179|                    p_user = parts[2] if len(parts) > 2 else ""
180|                    p_pass = parts[3] if len(parts) > 3 else ""
181|                    _set_proxy(d, p_host, p_port, p_user, p_pass)
182|                    proxy_set = True
183|                except Exception as pe:
184|                    return {"ok": False, "error": f"Proxy setup failed: {pe}", "step": "proxy"}
185|
186|        orig_disguise = _set_uk_disguise(d)
187|        _pause(1, 1.5)
188|
189|        # 1. Push video
190|        _push_and_scan(d, video_path)
191|        _pause(1, 2)
192|
193|        # 2. Launch Instagram
194|        d.app_stop(IG_PKG)
195|        _pause(0.5, 1)
196|        d.app_start(IG_PKG, use_monkey=True)
197|        _pause(3, 5)
198|
199|        if dry_run:
200|            return {"ok": True, "step": "dry_run_complete"}
201|
202|        # 3. Tap the "+" (creation) tab
203|        tapped = (
204|            _wait_tap(d, 8, resourceId=f"{IG_PKG}:id/creation_tab")
205|            or _wait_tap(d, 5, description="Create")
206|            or _wait_tap(d, 5, descriptionContains="reate")
207|        )
208|        if not tapped:
209|            return {"ok": False, "error": "Creation tab not found", "step": "open_creation"}
210|        _pause(1.5, 2.5)
211|
212|        # 4. Select REEL tab (Instagram sometimes opens on Post by default)
213|        reel_tab = d(textMatches="(?i)reel")
214|        if reel_tab.wait(timeout=5):
215|            reel_tab.click()
216|            _pause(1, 2)
217|
218|        # 5. Grant gallery permissions if prompted
219|        for txt in ("Allow", "Allow all", "ALLOW", "Дозволити"):
220|            btn = d(text=txt)
221|            if btn.exists:
222|                btn.click()
223|                _pause(0.5, 1.2)
224|
225|        # 6. Pick first (most recent) video from the grid
226|        # Try several known resource ids — they change between IG versions
227|        grid_ids = [
228|            f"{IG_PKG}:id/gallery_grid_item_thumbnail",
229|            f"{IG_PKG}:id/gallery_grid_item",
230|            f"{IG_PKG}:id/media_picker_grid_item",
231|        ]
232|        picked = False
233|        for rid in grid_ids:
234|            items = d(resourceId=rid)
235|            if items.wait(timeout=4):
236|                items.click()
237|                picked = True
238|                break
239|        if not picked:
240|            return {"ok": False, "error": "Gallery thumbnail not found", "step": "pick_video"}
241|        _pause(1.5, 2.5)
242|
243|        # 7. Next (video trimming / editing screen)
244|        if not _wait_tap(d, 10, descriptionMatches="(?i)next"):
245|            if not _wait_tap(d, 5, textMatches="(?i)next|далі"):
246|                return {"ok": False, "error": "Next (1) not found", "step": "next_1"}
247|        _pause(2, 3)
248|
249|        # 8. Next again (audio / clips / effects screen)
250|        if not _wait_tap(d, 10, descriptionMatches="(?i)next"):
251|            if not _wait_tap(d, 5, textMatches="(?i)next|далі"):
252|                return {"ok": False, "error": "Next (2) not found", "step": "next_2"}
253|        _pause(2, 3)
254|
255|        # 9. Paste caption
256|        if caption:
257|            cap_field = d(resourceId=f"{IG_PKG}:id/caption_input_text_view")
258|            if not cap_field.exists:
259|                cap_field = d(textMatches="(?i)write a caption|напишіть підпис")
260|            if cap_field.wait(timeout=5):
261|                cap_field.click()
262|                _pause(0.5, 1)
263|                d.send_keys(caption, clear=True)
264|                _pause(0.8, 1.5)
265|                # Close keyboard by pressing back
266|                d.press("back")
267|                _pause(0.5, 1)
268|
269|        # 10. Share button
270|        shared = (
271|            _wait_tap(d, 8, resourceId=f"{IG_PKG}:id/share_footer_button")
272|            or _wait_tap(d, 5, textMatches="(?i)share|поділитися")
273|        )
274|        if not shared:
275|            return {"ok": False, "error": "Share button not found", "step": "share"}
276|
277|        # 11. Wait for upload — the creation screen closes and we return to feed
278|        _pause(5, 8)
279|        return {"ok": True, "step": "shared"}
280|
281|    except Exception as e:
282|        return {"ok": False, "error": f"{type(e).__name__}: {e}", "step": "exception"}
283|
284|    finally:
285|        # Cleanup: restore proxy and locale
286|        try:
287|            if proxy_set:
288|                _clear_proxy(d)
289|            if orig_disguise:
290|                _restore_disguise(d, orig_disguise)
291|        except Exception:
292|            pass
293|
294|
295|def take_screenshot(serial: str | None = None) -> bytes | None:
296|    """Захоплює screenshot телефону як PNG bytes (для дзеркала або AI)."""
297|    try:
298|        d = _connect(serial)
299|        # uiautomator2 повертає PIL Image
300|        img = d.screenshot()
301|        if img is None:
302|            return None
303|        import io
304|        buf = io.BytesIO()
305|        img.save(buf, format="PNG")
306|        return buf.getvalue()
307|    except Exception as e:
308|        print(f"[screenshot] error: {e}", flush=True)
309|        return None
310|
311|
312|def read_reel_text(d, min_len: int = 30) -> str:
313|    """Витягує весь видимий текст з поточного рілсу через uiautomator2.
314|
315|    Проходить по дереву UI, збирає текст з TextView елементів.
316|    Фільтрує системні кнопки (Like, Comment, Share, Follow, усі числа і хештеги).
317|
318|    Returns: злитий текст або "" якщо недостатньо осмисленого контенту (<min_len символів).
319|    """
320|    try:
321|        # UI skip-патерни (системні кнопки і метадані)
322|        skip_exact = {
323|            "Like", "Comment", "Share", "Save", "Send", "Follow", "Following",
324|            "Like count", "More", "Remix", "Audio",
325|            "Лайк", "Коментар", "Поділитись", "Зберегти", "Підписатись",
326|            "Reels", "Рілс", "Рилс", "Subscribe", "Автор", "Sponsored", "Реклама",
327|            "more", "now", "h", "m", "s", "ago",
328|        }
329|        # Skip якщо текст виглядає як username (починається з @, без пробілів)
330|        def _is_junk(t: str) -> bool:
331|            t = t.strip()
332|            if not t or len(t) < 3:
333|                return True
334|            if t in skip_exact:
335|                return True
336|            if t.startswith("@") and " " not in t:
337|                return True
338|            # Тільки цифри / мітки часу / підписники
339|            if t.replace(",", "").replace(".", "").replace("K", "").replace("M", "").replace(" ", "").isdigit():
340|                return True
341|            return False
342|
343|        texts = []
344|        # Збираємо всі видимі TextView
345|        try:
346|            for el in d(className="android.widget.TextView"):
347|                try:
348|                    t = (el.info.get("text") or "").strip()
349|                    if t and not _is_junk(t):
350|                        texts.append(t)
351|                except Exception:
352|                    continue
353|        except Exception:
354|            pass
355|
356|        # Dedup, зберігаючи порядок
357|        seen = set()
358|        uniq = []
359|        for t in texts:
360|            if t not in seen:
361|                seen.add(t)
362|                uniq.append(t)
363|
364|        merged = " | ".join(uniq)
365|
366|        if len(merged) < min_len:
367|            return ""
368|        return merged[:2000]  # кеп на 2KB
369|    except Exception as e:
370|        print(f"[read_text] error: {e}", flush=True)
371|        return ""
372|
373|
374|def _ai_decide_reel_text(reel_text: str, niche: dict | None = None) -> dict:
375|    """Text-only AI decision — набагато швидше ніж vision.
376|
377|    Args:
378|        reel_text: caption/overlay текст
379|        niche: dict {description, keywords, avoid, examples} — якщо є, використовуємо
380|               замість хардкод промпту
381|    """
382|    import sys
383|    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
384|    from generate import _find_claude_cli
385|    import subprocess, re, json as _json
386|
387|    claude_cli = _find_claude_cli()
388|    if not claude_cli:
389|        return {"action": "skip", "reason": "Claude CLI не знайдено"}
390|
391|    # Будуємо niche prompt block (або hardcoded fallback)
392|    niche_block = _build_niche_block(niche)
393|
394|    prompt = (
395|        f"Оцінюєш Instagram Reel для прогріву акаунту.\n\n"
396|        f"{niche_block}\n\n"
397|        f"Текст з рілса (caption + overlay text): «{reel_text}»\n\n"
398|        f"Поверни ТІЛЬКИ JSON (без markdown):\n"
399|        f'{{"action": "like", "reason": "..."}}   — релевантний нашій ніші\n'
400|        f'{{"action": "save", "reason": "..."}}   — дуже цінний (глибокий, унікальний)\n'
401|        f'{{"action": "skip", "reason": "..."}}   — не наша ніша або в avoid\n\n'
402|        f"Reason одним реченням українською."
403|    )
404|
405|    try:
406|        result = subprocess.run(
407|            [claude_cli, "-p", prompt, "--output-format", "text"],
408|            capture_output=True, text=True, encoding="utf-8", timeout=20,
409|        )
410|        if result.returncode != 0:
411|            return {"action": "skip", "reason": f"CLI rc={result.returncode}"}
412|        text = (result.stdout or "").strip()
413|        if not text:
414|            return {"action": "skip", "reason": "пуста відповідь"}
415|        m = re.search(r"\{.*\}", text, re.DOTALL)
416|        if not m:
417|            return {"action": "skip", "reason": f"no JSON: {text[:80]}"}
418|        decision = _json.loads(m.group())
419|        action = decision.get("action", "skip")
420|        if action not in ("like", "save", "skip"):
421|            action = "skip"
422|        return {"action": action, "reason": decision.get("reason", "")}
423|    except subprocess.TimeoutExpired:
424|        return {"action": "skip", "reason": "timeout"}
425|    except Exception as e:
426|        return {"action": "skip", "reason": f"err: {e}"}
427|
428|
429|def _build_niche_block(niche: dict | None) -> str:
430|    """Будує блок тексту про нішу для AI prompt. Fallback до хардкоду якщо пуста."""
431|    if not niche or not isinstance(niche, dict):
432|        return (
433|            "Ніша: мотивація / воїнська філософія / саморозвиток / стоїцизм.\n"
434|            "Лайкаємо: цитати, воїни, спорт, дисципліна, успіх.\n"
435|            "Уникаємо: їжа, котики, мемчики, реклама."
436|        )
437|
438|    desc = (niche.get('description') or '').strip()
439|    keywords = niche.get('keywords') or []
440|    avoid = niche.get('avoid') or []
441|    examples = niche.get('examples') or []
442|
443|    # Якщо взагалі порожня — fallback
444|    if not desc and not keywords and not avoid:
445|        return (
446|            "Ніша: мотивація / воїнська філософія / саморозвиток / стоїцизм.\n"
447|            "Лайкаємо: цитати, воїни, спорт, дисципліна, успіх.\n"
448|            "Уникаємо: їжа, котики, мемчики, реклама."
449|        )
450|
451|    lines = []
452|    if desc:
453|        lines.append(f"Опис ніші: {desc}")
454|    if keywords:
455|        lines.append(f"Теми які ЛАЙКАЄМО: {', '.join(keywords)}")
456|    if avoid:
457|        lines.append(f"Теми які УНИКАЄМО: {', '.join(avoid)}")
458|    if examples:
459|        lines.append(f"Приклади релевантних акаунтів: {', '.join(examples)}")
460|    return "\n".join(lines)
461|
462|
463|def _ai_decide_reel(api_key_unused: str, screenshot_png: bytes,
464|                     model: str = "", niche: dict | None = None) -> dict:
465|    """Vision via claude.exe CLI: рішення що робити з рілсом.
466|
467|    Використовує локальну Claude Code CLI (не потребує API ключа — юзерська auth).
468|    Args:
469|        niche: dict {description, keywords, avoid, examples} — якщо є, використовуємо
470|               замість хардкод промпту
471|    Returns: {"action": "like"|"save"|"skip", "reason": "..."}
472|    """
473|    if not screenshot_png:
474|        return {"action": "skip", "reason": "no screenshot"}
475|
476|    # Пізнє імпортування щоб уникнути циклу
477|    import sys
478|    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
479|    from generate import _find_claude_cli
480|    import subprocess
481|    import tempfile
482|    import re
483|    import json as _json
484|
485|    claude_cli = _find_claude_cli()
486|    if not claude_cli:
487|        return {"action": "skip", "reason": "Claude CLI не знайдено"}
488|
489|    # Зберігаємо screenshot у тимчасовий файл
490|    tmp = tempfile.NamedTemporaryFile(suffix=".png", delete=False)
491|    try:
492|        tmp.write(screenshot_png)
493|        tmp.close()
494|        screenshot_path = tmp.name
495|
496|        niche_block = _build_niche_block(niche)
497|        prompt = (
498|            f"Проаналізуй Instagram Reel screenshot для прогріву акаунту.\n\n"
499|            f"{niche_block}\n\n"
500|            f"Зображення: @{screenshot_path}\n\n"
501|            f"Поверни ТІЛЬКИ JSON (без markdown) одним з варіантів:\n"
502|            f'{{"action": "like", "reason": "..."}}   — релевантний ніші\n'
503|            f'{{"action": "save", "reason": "..."}}   — дуже цінний контент (глибокий, унікальний)\n'
504|            f'{{"action": "skip", "reason": "..."}}   — поза нішею або в avoid\n\n'
505|            f"Reason — одним коротким реченням українською."
506|        )
507|
508|        result = subprocess.run(
509|            [claude_cli, "-p", prompt, "--output-format", "text", "--allowedTools", "Read"],
510|            capture_output=True, text=True, encoding="utf-8", timeout=30,
511|        )
512|
513|        if result.returncode != 0:
514|            return {"action": "skip", "reason": f"CLI rc={result.returncode}: {(result.stderr or '')[:150]}"}
515|
516|        text = (result.stdout or "").strip()
517|        if not text:
518|            return {"action": "skip", "reason": "CLI порожня відповідь"}
519|
520|        m = re.search(r"\{.*\}", text, re.DOTALL)
521|        if not m:
522|            return {"action": "skip", "reason": f"no JSON in: {text[:100]}"}
523|        try:
524|            decision = _json.loads(m.group())
525|        except _json.JSONDecodeError as e:
526|            return {"action": "skip", "reason": f"JSON parse: {e}"}
527|
528|        action = decision.get("action", "skip")
529|        if action not in ("like", "save", "skip"):
530|            action = "skip"
531|        return {"action": action, "reason": decision.get("reason", "")}
532|    except subprocess.TimeoutExpired:
533|        return {"action": "skip", "reason": "CLI timeout (30s)"}
534|    except Exception as e:
535|        return {"action": "skip", "reason": f"AI error: {e}"}
536|    finally:
537|        try:
538|            os.unlink(screenshot_path)
539|        except Exception:
540|            pass
541|
542|
543|def _dismiss_save_sheet(d) -> None:
544|    """
545|    Instagram після save може відкрити "Save to collection" bottom sheet.
546|    Закриваємо його: шукаємо кнопку Done, інакше press back.
547|    Це КРИТИЧНО — без цього swipe до наступного рілсу не працює.
548|    """
549|    import time
550|    time.sleep(0.6)  # дати UI намалювати sheet
551|    try:
552|        # Варіант 1: кнопка "Done" у bottom sheet
553|        for label in ("Done", "Готово", "Save", "Зберегти"):
554|            btn = d(text=label)
555|            if hasattr(btn, 'exists') and btn.exists:
556|                btn.click()
557|                time.sleep(0.4)
558|                return
559|        # Варіант 2: діалог "Save to collection" → press back
560|        # Перевіряємо типові елементи collection picker
561|        sheet_markers = [
562|            d(textContains="Save to"),
563|            d(textContains="Збер"),
564|            d(textContains="collection"),
565|            d(textContains="колекц"),
566|        ]
567|        if any(hasattr(m, 'exists') and m.exists for m in sheet_markers):
568|            d.press("back")
569|            time.sleep(0.4)
570|            return
571|        # Варіант 3 (fallback): завжди press back — безпечно, нічого не зламає
572|        # якщо sheet не відкрився (просто закриє поточний екран, а Instagram
573|        # одразу відновиться, оскільки Reels — головний tab)
574|        # НЕ робимо цей fallback — ризик вийти з Reels
575|    except Exception as e:
576|        print(f"[save-dismiss] error: {e}", flush=True)
577|
578|
579|def _save_reel(d) -> bool:
580|    """Зберегти рілс — тап на кнопку bookmark/save, потім закрити можливий діалог."""
581|    try:
582|        save_btn = (
583|            d(resourceId=f"{IG_PKG}:id/row_feed_button_save")
584|            or d(descriptionContains="Save")
585|            or d(descriptionContains="Зберегти")
586|        )
587|        if hasattr(save_btn, 'exists') and save_btn.exists:
588|            save_btn.click()
589|            # КРИТИЧНО: закрити bottom sheet якщо відкрився
590|            _dismiss_save_sheet(d)
591|            return True
592|    except Exception as e:
593|        print(f"[save] error: {e}", flush=True)
594|    return False
595|
596|
597|def scroll_reels(
598|    serial: str | None = None,
599|    duration_seconds: int = 120,
600|    like_probability: float = 0.15,
601|    proxy: str | None = None,
602|    use_ai: bool = False,
603|    claude_api_key: str = "",
604|    niche: dict | None = None,
605|    expected_username: str | None = None,  # активний IG акаунт має бути = цим
606|) -> dict:
607|    """
608|    Open Instagram Reels and scroll like a real person.
609|
610|    Simulates:
611|    - Random watch time per reel (3–18 s)
612|    - Human-like swipe speed and distance
613|    - Occasional likes (like_probability = 0–1)
614|    - Rare double-tap likes instead of button tap
615|    - Occasional scroll-back (re-watch a bit)
616|    - Random micro-pauses mid-scroll
617|
618|    Args:
619|        serial: ADB serial (None = auto-detect)
620|        duration_seconds: total warm-up time in seconds
621|        like_probability: chance to like each reel (0.15 = 15%)
622|        proxy: "host:port" EU/UK proxy for geo-masking
623|
624|    Returns:
625|        {"ok": bool, "reels_watched": int, "likes_given": int, "duration": float}
626|    """
627|    try:
628|        d = _connect(serial)
629|    except Exception as e:
630|        return {"ok": False, "error": f"Device connect failed: {e}"}
631|
632|    proxy_set = False
633|    orig_disguise = None
634|
635|    try:
636|        if proxy:
637|            parts = proxy.strip().split(":")
638|            if len(parts) >= 2:
639|                try:
640|                    _set_proxy(d, parts[0], int(parts[1]),
641|                               parts[2] if len(parts) > 2 else "",
642|                               parts[3] if len(parts) > 3 else "")
643|                    proxy_set = True
644|                except Exception as pe:
645|                    return {"ok": False, "error": f"Proxy setup failed: {pe}"}
646|
647|        orig_disguise = _set_uk_disguise(d)
648|
649|        # ── 0. Wake + unlock screen ───────────────────────────────────
650|        # Wake screen if off
651|        d.shell("input keyevent KEYCODE_WAKEUP")
652|        time.sleep(1)
653|        # Check if lockscreen is showing — swipe up to dismiss
654|        screen_on = d.info.get("screenOn", True)
655|        if not screen_on or d(resourceId="com.android.systemui:id/lockscreen_status_view").exists \
656|                or d(descriptionContains="unlock").exists \
657|                or d(textContains="Swipe").exists:
658|            info = d.info
659|            w2 = info.get("displayWidth", 1080)
660|            h2 = info.get("displayHeight", 1920)
661|            d.swipe(w2 // 2, int(h2 * 0.8), w2 // 2, int(h2 * 0.2), duration=0.4)
662|            time.sleep(1.2)
663|        # Second wake attempt (some phones need two presses)
664|        d.shell("input keyevent KEYCODE_MENU")
665|        time.sleep(0.5)
666|
667|        # ── 1. Open Instagram ──────────────────────────────────────────
668|        d.app_stop(IG_PKG)
669|        _pause(0.5, 1.2)
670|        d.app_start(IG_PKG, use_monkey=True)
671|        _pause(3.5, 5.5)
672|
673|        # ── 1.5. Ніжна перевірка активного акаунта (2026-09-20) ────────
674|        # Перед прогрівом переконуємось що активний IG акаунт = той, для якого
675|        # заплановано прогрів. Заходимо на Profile (1 тап, без світчера),
676|        # читаємо username. Якщо не той — ТОДІ перемикаємось через світчер.
677|        # Якщо потрібного немає на пристрої — помилка, щоб не гріти чужий.
678|        if expected_username:
679|            ok_acc, acc_msg = _ensure_ig_account(d, expected_username)
680|            if not ok_acc:
681|                return {"ok": False, "error": f"Account check: {acc_msg}"}
682|            _pause(0.5, 1.0)
683|
684|        # ── 2. Navigate to Reels tab ───────────────────────────────────
685|        # Try dedicated Reels tab first
686|        reel_nav = (
687|            d(resourceId=f"{IG_PKG}:id/clips_tab")
688|            or d(description="Reels")
689|            or d(descriptionContains="Reel")
690|            or d(textMatches="(?i)reel")
691|        )
692|        if hasattr(reel_nav, 'wait') and reel_nav.wait(timeout=6):
693|            reel_nav.click()
694|            _pause(2, 3.5)
695|        else:
696|            # Fallback: swipe from home feed — Reels are in the feed too
697|            pass
698|
699|        # Screen dimensions for swipe calculations
700|        info = d.info
701|        w = info.get("displayWidth", 1080)
702|        h = info.get("displayHeight", 1920)
703|        cx = w // 2
704|
705|        reels_watched = 0
706|        likes_given   = 0
707|        saves_given   = 0
708|        ai_decisions  = []  # last 5 decisions для діагностики
709|        start_time    = time.time()
710|
711|        while (time.time() - start_time) < duration_seconds:
712|            remaining = duration_seconds - (time.time() - start_time)
713|            if remaining <= 0:
714|                break
715|
716|            # ── Watch current reel ─────────────────────────────────────
717|            watch_time = random.uniform(3.5, 18.0)
718|            watch_time = min(watch_time, remaining)
719|            reels_watched += 1
720|
721|            # Micro-pause behaviour during watch (simulate thumb movement)
722|            elapsed = 0.0
723|            while elapsed < watch_time:
724|                chunk = random.uniform(1.5, 4.0)
725|                chunk = min(chunk, watch_time - elapsed)
726|                time.sleep(chunk)
727|                elapsed += chunk
728|
729|                # Rare: scroll up a tiny bit (re-watch gesture)
730|                if random.random() < 0.08 and elapsed < watch_time - 1:
731|                    scroll_up_px = random.randint(80, 200)
732|                    d.swipe(cx, h // 2, cx, h // 2 + scroll_up_px,
733|                            duration=random.uniform(0.25, 0.5))
734|                    time.sleep(random.uniform(0.4, 1.0))
735|                    # Scroll back down immediately
736|                    d.swipe(cx, h // 2 + scroll_up_px, cx, h // 2 - 50,
737|                            duration=random.uniform(0.2, 0.4))
738|                    time.sleep(random.uniform(0.3, 0.8))
739|
740|            # ── Decide: like / save / skip ─────────────────────────────
741|            decision_action = None
742|            if use_ai:
743|                # Гібрид: спочатку пробуємо швидкий text-only decision
744|                ai_dec = None
745|                ai_mode = ""
746|                reel_text = read_reel_text(d, min_len=30)
747|                if reel_text:
748|                    ai_dec = _ai_decide_reel_text(reel_text, niche=niche)
749|                    ai_mode = "text"
750|                else:
751|                    # Fallback на screenshot vision якщо тексту мало/нема
752|                    shot = take_screenshot(serial)
753|                    if shot:
754|                        ai_dec = _ai_decide_reel(claude_api_key, shot, niche=niche)
755|                        ai_mode = "vision"
756|                if ai_dec:
757|                    decision_action = ai_dec.get("action", "skip")
758|                    ai_dec["mode"] = ai_mode
759|                    ai_decisions.append(ai_dec)
760|                    if len(ai_decisions) > 10:
761|                        ai_decisions.pop(0)
762|                    print(f"[AI/{ai_mode}] {decision_action}: {ai_dec.get('reason','')}", flush=True)
763|
764|                    # Stuck detection: 3 однакові skip-причини про "збереження" поспіль = застрягли на save-діалозі
765|                    recent_reasons = [x.get("reason", "") for x in ai_decisions[-3:]
766|                                      if x.get("action") == "skip"]
767|                    if (len(recent_reasons) == 3 and
768|                        len(set(recent_reasons)) == 1 and
769|                        any(k in recent_reasons[0].lower()
770|                            for k in ("збереженн", "save", "колекц", "collect"))):
771|                        print("[stuck] detected save-dialog loop → press back", flush=True)
772|                        try:
773|                            d.press("back")
774|                            time.sleep(0.5)
775|                        except Exception:
776|                            pass
777|                        ai_decisions.clear()
778|            else:
779|                # Random mode (легасі поведінка)
780|                if random.random() < like_probability:
781|                    decision_action = "like"
782|
783|            if decision_action == "like":
784|                use_double_tap = random.random() < 0.4
785|                if use_double_tap:
786|                    tap_x = cx + random.randint(-80, 80)
787|                    tap_y = h // 2 + random.randint(-100, 100)
788|                    d.double_click(tap_x, tap_y, duration=0.08)
789|                else:
790|                    like_btn = d(resourceId=f"{IG_PKG}:id/row_feed_button_like")
791|                    if not like_btn.exists:
792|                        like_btn = d(descriptionContains="Like")
793|                    if like_btn.exists:
794|                        like_btn.click()
795|                likes_given += 1
796|                _pause(0.4, 1.0)
797|            elif decision_action == "save":
798|                if _save_reel(d):
799|                    saves_given += 1
800|                    _pause(0.4, 1.0)
801|                else:
802|                    # Fallback на лайк якщо save не знайдено
803|                    like_btn = d(resourceId=f"{IG_PKG}:id/row_feed_button_like")
804|                    if hasattr(like_btn, 'exists') and like_btn.exists:
805|                        like_btn.click()
806|                        likes_given += 1
807|                        _pause(0.4, 1.0)
808|
809|            # ── Scroll to next reel ────────────────────────────────────
810|            if (time.time() - start_time) >= duration_seconds:
811|                break
812|
813|            swipe_start_y = int(h * random.uniform(0.72, 0.82))
814|            swipe_end_y   = int(h * random.uniform(0.12, 0.22))
815|            swipe_dur     = random.uniform(0.18, 0.42)  # faster = more natural for reels
816|
817|            d.swipe(cx + random.randint(-20, 20),
818|                    swipe_start_y,
819|                    cx + random.randint(-20, 20),
820|                    swipe_end_y,
821|                    duration=swipe_dur)
822|
823|            # Short pause after swipe (feed loads next reel)
824|            _pause(0.6, 1.8)
825|
826|        # ── Завершення: home screen → lock phone (природна поведінка) ──
827|        try:
828|            d.press("home")                           # Instagram у фон (не kill — реальні юзери так не роблять)
829|            time.sleep(random.uniform(1.2, 2.5))      # пауза як у живої людини
830|            d.shell("input keyevent KEYCODE_POWER")    # блокуємо екран
831|        except Exception as e:
832|            print(f"[exit] error: {e}", flush=True)
833|
834|        elapsed_total = time.time() - start_time
835|        return {
836|            "ok": True,
837|            "reels_watched": reels_watched,
838|            "likes_given": likes_given,
839|            "saves_given": saves_given,
840|            "duration": round(elapsed_total, 1),
841|            "ai_decisions": ai_decisions,
842|        }
843|
844|    except Exception as e:
845|        return {"ok": False, "error": f"{type(e).__name__}: {e}"}
846|
847|    finally:
848|        try:
849|            if proxy_set:
850|                _clear_proxy(d)
851|            if orig_disguise:
852|                _restore_disguise(d, orig_disguise)
853|        except Exception:
854|            pass
855|
856|
857|def list_devices() -> dict:
858|    """List all ADB-connected devices. Uses adbutils (bundled with uiautomator2)."""
859|    try:
860|        import adbutils
861|        adb = adbutils.AdbClient()
862|        devices = [d.serial for d in adb.device_list()]
863|        return {"ok": True, "devices": devices}
864|    except Exception as e:
865|        # Fallback to system adb if adbutils fails
866|        try:
867|            import subprocess
868|            result = subprocess.run(
869|                ["adb", "devices"], capture_output=True, text=True, timeout=10
870|            )
871|            lines = result.stdout.strip().splitlines()[1:]
872|            devices = [
873|                parts[0] for line in lines
874|                if len(parts := line.split()) >= 2 and parts[1] == "device"
875|            ]
876|            return {"ok": True, "devices": devices}
877|        except FileNotFoundError:
878|            return {"ok": False, "error": f"adbutils failed ({e}), adb not in PATH"}
879|        except Exception as e2:
880|            return {"ok": False, "error": str(e2)}
881|
882|
883|# ───────────────────────── WiFi ADB helpers ──────────────────────────
884|
885|def _find_adb() -> str:
886|    """Find adb executable: PATH first, then adbutils bundled binary."""
887|    import shutil, sys, os
888|    # 1. System PATH
889|    found = shutil.which("adb")
890|    if found:
891|        return found
892|    # 2. adbutils bundled adb (installed with uiautomator2)
893|    try:
894|        import adbutils
895|        pkg_dir = os.path.dirname(adbutils.__file__)
896|        candidates = [
897|            os.path.join(pkg_dir, "binaries", "adb.exe"),   # Windows
898|            os.path.join(pkg_dir, "binaries", "adb"),        # Linux/Mac
899|        ]
900|        for c in candidates:
901|            if os.path.isfile(c):
902|                return c
903|    except Exception:
904|        pass
905|    # 3. Same Python prefix
906|    prefix = os.path.dirname(sys.executable)
907|    for rel in (r"Lib\site-packages\adbutils\binaries\adb.exe",
908|                "lib/python*/site-packages/adbutils/binaries/adb"):
909|        import glob
910|        matches = glob.glob(os.path.join(prefix, rel))
911|        if matches:
912|            return matches[0]
913|    return "adb"  # last resort — will fail with clear error
914|
915|
916|def _run_adb(*args: str, timeout: int = 15) -> dict:
917|    """Run an adb command and return {"ok", "output"} or {"ok": False, "error"}."""
918|    import subprocess
919|    adb_bin = _find_adb()
920|    cmd = [adb_bin] + list(args)
921|    try:
922|        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
923|        out = (r.stdout + r.stderr).strip()
924|        if r.returncode != 0:
925|            return {"ok": False, "error": out or f"adb exited {r.returncode}"}
926|        return {"ok": True, "output": out}
927|    except FileNotFoundError:
928|        return {"ok": False, "error": "adb не знайдено. Встанови Android Platform Tools або uiautomator2."}
929|    except subprocess.TimeoutExpired:
930|        return {"ok": False, "error": f"adb timeout ({timeout}s)"}
931|    except Exception as exc:
932|        return {"ok": False, "error": str(exc)}
933|
934|
935|def adb_pair(host: str, code: str) -> dict:
936|    """
937|    Android 11+ wireless pairing: adb pair <host:port> <6-digit-code>.
938|    host — IP:port shown under «Pair with pairing code» in Developer Options.
939|    """
940|    code = code.strip()
941|    host = host.strip()
942|    if ":" not in host:
943|        return {"ok": False, "error": "host має бути у форматі IP:port (напр. 192.168.1.50:41234)"}
944|    if not code.isdigit() or len(code) != 6:
945|        return {"ok": False, "error": "Код має бути 6-значним числом"}
946|    result = _run_adb("pair", host, code, timeout=20)
947|    if not result["ok"]:
948|        return result
949|    out = result["output"]
950|    # adb pair returns "Successfully paired to …" on success
951|    if "successfully" in out.lower() or "paired" in out.lower():
952|        return {"ok": True, "message": out}
953|    return {"ok": False, "error": out}
954|
955|
956|def adb_connect(host: str) -> dict:
957|    """
958|    Connect to device over WiFi: adb connect <host[:port]>.
959|    After successful pair (Android 11+) use the main port (usually 5555).
960|    For legacy tcpip flow use the same port you set with adb_tcpip().
961|    Tries adbutils first (bundled with uiautomator2), then falls back to adb CLI.
962|    """
963|    host = host.strip()
964|    if ":" not in host:
965|        host = f"{host}:5555"
966|
967|    # Try adbutils (no system adb required)
968|    try:
969|        import adbutils
970|        adb = adbutils.AdbClient()
971|        adb.connect(host, timeout=15)
972|        return {"ok": True, "serial": host, "message": f"connected to {host}"}
973|    except Exception:
974|        pass  # fallback to adb CLI
975|
976|    result = _run_adb("connect", host, timeout=15)
977|    if not result["ok"]:
978|        return result
979|    out = result["output"]
980|    if "connected" in out.lower():
981|        return {"ok": True, "serial": host, "message": out}
982|    return {"ok": False, "error": out}
983|
984|
985|def adb_ping_device(host: str, timeout: int = 3) -> dict:
986|    """
987|    Реальна перевірка чи пристрій живий. adb connect/devices кешує стан,
988|    тому єдиний надійний спосіб — виконати команду на пристрої.
989|    Повертає {"ok": True, "state": "device"} якщо пристрій відповідає,
990|    {"ok": False, "state": "offline"/"unauthorized"/"missing", "error": ...} інакше.
991|    """
992|    host = host.strip()
993|    if ":" not in host:
994|        host = f"{host}:5555"
995|
996|    # Спершу перевіряємо стан у adb devices (швидко, без запиту до пристрою)
997|    devs = _run_adb("devices", timeout=3)
998|    if not devs["ok"]:
999|        return {"ok": False, "state": "adb-error", "error": devs.get("error")}
1000|
1001|    state = "missing"
1002|    for line in devs["output"].splitlines():
1003|        line = line.strip()
1004|        if line.startswith(host):
1005|            parts = line.split()
1006|            if len(parts) >= 2:
1007|                state = parts[1]  # device | offline | unauthorized
1008|            break
1009|
1010|    if state != "device":
1011|        return {"ok": False, "state": state,
1012|                "error": f"adb state={state} (треба 'device')"}
1013|
1014|    # Реальний ping — виконуємо команду на пристрої
1015|    r = _run_adb("-s", host, "shell", "echo", "ok", timeout=timeout)
1016|    if not r["ok"]:
1017|        return {"ok": False, "state": "unreachable", "error": r.get("error")}
1018|    if "ok" not in (r.get("output") or ""):
1019|        return {"ok": False, "state": "unreachable",
1020|                "error": f"unexpected shell output: {r.get('output')}"}
1021|
1022|    return {"ok": True, "state": "device", "host": host}
1023|
1024|
1025|def adb_tcpip(serial: str | None, port: int = 5555) -> dict:
1026|    """
1027|    Legacy approach (Android <11): switch a USB-connected device to TCP mode.
1028|    After this command succeeds, unplug the USB cable, then call adb_connect(phone_ip).
1029|    """
1030|    args = []
1031|    if serial:
1032|        args += ["-s", serial]
1033|    args += ["tcpip", str(port)]
1034|    result = _run_adb(*args, timeout=15)
1035|    if not result["ok"]:
1036|        return result
1037|    out = result["output"]
1038|    if "restarting" in out.lower() or "tcpip" in out.lower():
1039|        return {"ok": True, "port": port, "message": out}
1040|    return {"ok": False, "error": out}
1041|
1042|
1043|def adb_disconnect(host: str) -> dict:
1044|    """Disconnect a WiFi ADB device. Tries adbutils first, then adb CLI."""
1045|    host = host.strip()
1046|    if ":" not in host:
1047|        host = f"{host}:5555"
1048|
1049|    try:
1050|        import adbutils
1051|        adb = adbutils.AdbClient()
1052|        adb.disconnect(host)
1053|        return {"ok": True, "message": f"disconnected {host}"}
1054|    except Exception:
1055|        pass  # fallback to adb CLI
1056|
1057|    result = _run_adb("disconnect", host, timeout=10)
1058|    if not result["ok"]:
1059|        return result
1060|    return {"ok": True, "message": result["output"]}
1061|
1062|
1063|def adb_mdns_discover() -> dict:
1064|    """
1065|    Discover Wireless Debugging (Android 11+) devices on the local network via mDNS.
1066|    Returns list of {"name", "host"} where host is "ip:port" ready for adb connect.
1067|    Requires: Wireless Debugging enabled on phone, laptop+phone on same Wi-Fi.
1068|    """
1069|    import re
1070|    result = _run_adb("mdns", "services", timeout=8)
1071|    if not result["ok"]:
1072|        return {"ok": False, "error": result.get("error", "mdns failed"), "devices": []}
1073|
1074|    devices = []
1075|    for line in result["output"].splitlines():
1076|        line = line.strip()
1077|        # Формат рядка: "adb-<name>._adb-tls-connect._tcp\t_adb-tls-connect._tcp\t192.168.0.7:41935"
1078|        # або:          "adb-<name>._adb._tcp\t_adb._tcp\t192.168.0.7:5555"
1079|        # Беремо ТІЛЬКИ _adb-tls-connect (Wireless Debug), ігноруємо _adb._tcp (pairing)
1080|        m = re.search(r"(adb-[\w\-]+)\.(_adb-tls-connect)\._tcp.*?(\d+\.\d+\.\d+\.\d+:\d+)", line)
1081|        if m:
1082|            devices.append({"name": m.group(1), "host": m.group(3)})
1083|    return {"ok": True, "devices": devices}
1084|
1085|
1086|def _wake_and_unlock(d) -> dict:
1087|    """Будить екран і намагається розблокувати (без PIN — лише swipe up)."""
1088|    import time
1089|    try:
1090|        # Перевіряємо стан
1091|        power_out = d.shell("dumpsys power | grep mWakefulness").output
1092|        if "Asleep" in power_out or "Dozing" in power_out:
1093|            d.shell("input keyevent KEYCODE_WAKEUP")
1094|            time.sleep(1.5)
1095|        # Якщо екран заблокований — свайп вгору
1096|        info = d.info
1097|        w = info.get("displayWidth", 1080)
1098|        h = info.get("displayHeight", 1920)
1099|        # Універсальний swipe від низу до верху (прибирає lock screen без PIN)
1100|        d.swipe(w // 2, int(h * 0.85), w // 2, int(h * 0.25), duration=0.25)
1101|        time.sleep(1.0)
1102|        return {"ok": True}
1103|    except Exception as e:
1104|        return {"ok": False, "error": str(e)}
1105|
1106|
1107|def get_all_ig_accounts(serial: str | None = None) -> dict:
1108|    """
1109|    Знаходить ВСІ залогінені IG акаунти на пристрої.
1110|    Надійний flow: cold-launch IG → tap profile_tab (only via resource-id) →
1111|    wait profile_header_container → read action_bar_title → open switcher → parse.
1112|    Повертає {ok, active, all: [username, ...], debug?}.
1113|    """
1114|    import time, re
1115|    try:
1116|        d = _connect(serial)
1117|    except Exception as e:
1118|        return {"ok": False, "error": f"connect fail: {e}"}
1119|
1120|    try:
1121|        # Крок 0: розблокувати/розбудити (більш наполегливо, для Xiaomi-MIUI)
1122|        try:
1123|            d.shell("svc power stayon true")
1124|        except Exception: pass
1125|        _wake_and_unlock(d)
1126|        # Ще одна спроба: KEYCODE_WAKEUP + перевірка Display Power
1127|        try:
1128|            for _ in range(3):
1129|                power = d.shell("dumpsys power | grep 'Display Power'").output
1130|                if "state=ON" in power:
1131|                    break
1132|                d.shell("input keyevent KEYCODE_WAKEUP")
1133|                time.sleep(1.0)
1134|                d.shell("wm dismiss-keyguard")
1135|                time.sleep(0.5)
1136|        except Exception: pass
1137|        # Якщо після наших спроб екран досі OFF — повідомляємо користувача
1138|        try:
1139|            power = d.shell("dumpsys power | grep 'Display Power'").output
1140|            if "state=OFF" in power:
1141|                return {"ok": False,
1142|                        "error": "Телефон не прокидається через Wi-Fi ADB. Натисни Power button фізично і спробуй знову."}
1143|        except Exception: pass
1144|
1145|        if not d.app_info(IG_PKG).get("versionName"):
1146|            return {"ok": False, "error": "Instagram не встановлено на пристрої"}
1147|
1148|        # Cold start IG (не полагаємось на current state)
1149|        d.app_stop(IG_PKG)
1150|        time.sleep(1)
1151|        d.app_start(IG_PKG, use_monkey=True)
1152|
1153|        # Чекаємо завантаження tab_bar (готовність IG)
1154|        ig_ready = False
1155|        for i in range(20):   # 20s — для повільніших пристроїв / cold start
1156|            time.sleep(1)
1157|            try:
1158|                if d(resourceId=f"{IG_PKG}:id/tab_bar").exists:
1159|                    ig_ready = True
1160|                    break
1161|            except Exception:
1162|                continue
1163|        if not ig_ready:
1164|            return {"ok": False,
1165|                    "error": "IG не завантажився (tab_bar не видно). Можливо IG показує login/update screen — відкрий вручну."}
1166|
1167|        # Крок 1: Tap Profile tab ТІЛЬКИ через resource-id (стабільно, не натрапить на reel)
1168|        try:
1169|            tab = d(resourceId=f"{IG_PKG}:id/profile_tab")
1170|            if not tab.exists:
1171|                return {"ok": False, "error": "profile_tab не знайдено — IG UI оновлено?"}
1172|            tab.click()
1173|        except Exception as e:
1174|            return {"ok": False, "error": f"profile_tab click: {e}"}
1175|
1176|        # Крок 2: Чекаємо Profile screen (перевіряємо profile_header_container)
1177|        on_profile = False
1178|        for i in range(12):
1179|            time.sleep(0.6)
1180|            try:
1181|                if d(resourceId=f"{IG_PKG}:id/profile_header_container").exists:
1182|                    on_profile = True
1183|                    break
1184|            except Exception:
1185|                continue
1186|        if not on_profile:
1187|            return {"ok": False,
1188|                    "error": "Profile screen не завантажився (profile_header_container not visible)"}
1189|
1190|        # Крок 3: Читаємо username з action_bar_title (тільки на Profile воно = username)
1191|        active_username = None
1192|        title_el = None
1193|        try:
1194|            el = d(resourceId=f"{IG_PKG}:id/action_bar_title")
1195|            if el.exists:
1196|                t_text = (el.get_text() or "").strip().lstrip('@')
1197|                # content-desc на Profile має збігатись з text (подвійна перевірка)
1198|                try:
1199|                    t_desc = (el.info.get("contentDescription") or "").strip().lstrip('@')
1200|                except Exception:
1201|                    t_desc = ""
1202|                if re.match(r'^[a-z0-9._]{1,30}$', t_text.lower()):
1203|                    if not t_desc or t_desc.lower() == t_text.lower():
1204|                        active_username = t_text.lower()
1205|                        title_el = el
1206|        except Exception:
1207|            pass
1208|        if not active_username:
1209|            return {"ok": False, "error": "Username не знайдено в action_bar_title на Profile"}
1210|
1211|        # Крок 3: кілька спроб відкрити account switcher
1212|        # Sheet markers щоб переконатись що він реально відкрився:
1213|        sheet_markers = ["Add Instagram account", "Go to Accounts Center",
1214|                         "Add account", "Log in to existing account",
1215|                         "Створити новий", "Увійти до існуючого",
1216|                         "Switch accounts", "Switch Account"]
1217|
1218|        def sheet_is_open():
1219|            try:
1220|                hier = d.dump_hierarchy()
1221|                return any(m in hier for m in sheet_markers)
1222|            except Exception:
1223|                return False
1224|
1225|        switcher_opened = False
1226|        # Спроба 1: тап на title
1227|        try:
1228|            title_el.click()
1229|            time.sleep(1.8)
1230|            switcher_opened = sheet_is_open()
1231|        except Exception:
1232|            pass
1233|
1234|        # Спроба 2: long-press на title (відкриває switcher на деяких версіях)
1235|        if not switcher_opened:
1236|            try:
1237|                bounds = title_el.info.get('bounds', {})
1238|                if bounds:
1239|                    cx = (bounds['left'] + bounds['right']) // 2
1240|                    cy = (bounds['top'] + bounds['bottom']) // 2
1241|                    d.long_click(cx, cy, duration=0.5)
1242|                    time.sleep(1.8)
1243|                    switcher_opened = sheet_is_open()
1244|            except Exception:
1245|                pass
1246|
1247|        # Спроба 3: тап на chevron arrow праворуч від title
1248|        if not switcher_opened:
1249|            try:
1250|                # Зазвичай chevron справа від username у action bar
1251|                bounds = title_el.info.get('bounds', {})
1252|                if bounds:
1253|                    chevron_x = bounds['right'] + 40
1254|                    chevron_y = (bounds['top'] + bounds['bottom']) // 2
1255|                    d.click(chevron_x, chevron_y)
1256|                    time.sleep(1.8)
1257|                    switcher_opened = sheet_is_open()
1258|            except Exception:
1259|                pass
1260|
1261|        # Крок 4: парс — ЗАВЖДИ, незалежно від тендітних текстових маркерів світчера.
1262|        # (2026-09-20) Раніше парс ішов лише `if switcher_opened:` — а той прапорець
1263|        # виставлявся по мовозалежних рядках "Add account/Створити новий/...".
1264|        # На Redmi світчер відкривався, але жоден маркер не співпав → парс пропускався
1265|        # і повертався тільки active. Тепер думпуємо й парсимо ієрархію завжди:
1266|        # якщо відкрито світчер — зберемо всі; якщо ні — буде тільки active.
1267|        accounts_found = {active_username.lower()}
1268|        debug_hits = []
1269|
1270|        # Regex для валідного IG username
1271|        username_re = re.compile(r'^[a-z0-9](?:[a-z0-9._]{0,28}[a-z0-9])?$')
1272|
1273|        blacklist = {
1274|            'profile','follow','message','edit','share','settings','home','search',
1275|            'reels','activity','shop','following','followers','posts','tagged',
1276|            'dashboard','insights','professional','creator','personal','add','done',
1277|            'close','cancel','ok','save','next','continue','switch','logout','log',
1278|            'stories','notes','video','tag','new','see','all','your','my','about',
1279|            'profile','bio','link','accounts','login','сторінки','профіль',
1280|        }
1281|
1282|        try:
1283|            hierarchy = d.dump_hierarchy()
1284|
1285|            # Парсимо тільки текст що ВИГЛЯДАЄ як username:
1286|            # Має бути РІВНО lowercase у оригіналі (не full name)
1287|            # і матчити regex
1288|            node_pattern = re.compile(r'<node[^>]*text="([^"]+)"', re.IGNORECASE)
1289|
1290|            for m in node_pattern.finditer(hierarchy):
1291|                text = m.group(1).strip().lstrip('@')
1292|                if not text or len(text) < 3 or len(text) > 30:
1293|                    continue
1294|                # КРИТИЧНО: original text має бути lowercase (без Full Name)
1295|                if text != text.lower():
1296|                    continue
1297|                if text in blacklist:
1298|                    continue
1299|                if not username_re.match(text):
1300|                    continue
1301|                if text.isdigit():
1302|                    continue
1303|                # УМОВУ ПРИБРАНО (2026-09-20): раніше тут стояло
1304|                #   if '.' not in text and '_' not in text and len(text) < 5: continue
1305|                # що викидало КОРОТКІ username без крапок/підкреслень (помилка —
1306|                # юзер втрачав другий акаунт на Redmi). Тепер ловимо всі, хто
1307|                # схожий на username. Full Name і раніше відсіюється умовою
1308|                # `text != text.lower()` вище, тож це не ловить імена.
1309|                accounts_found.add(text)
1310|                debug_hits.append(text)
1311|        except Exception as e:
1312|            print(f"[ig-accounts] dump fail: {e}", flush=True)
1313|
1314|        # Закриваємо sheet
1315|        try:
1316|            d.press("back")
1317|            time.sleep(0.5)
1318|        except Exception:
1319|            pass
1320|
1321|        return {
1322|            "ok": True,
1323|            "active": active_username.lower() if active_username else None,
1324|            "all": sorted(accounts_found),
1325|            "debug": {
1326|                "switcher_opened": switcher_opened,
1327|                "hits": debug_hits[:20],
1328|            },
1329|        }
1330|
1331|    except Exception as e:
1332|        return {"ok": False, "error": f"{type(e).__name__}: {e}"}
